---
import '../styles/global.css';
import { getLangFromUrl, getLocalizedPathname } from '../i18n/utils.ts';
import {
  supportedLanguages,
  ui,
  type SupportedLanguage,
} from '../i18n/config.ts';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'DOF-RAG',
  description = 'Investigación abierta sobre sistemas de recuperación para el Diario Oficial de la Federación.',
} = Astro.props;
const currentPath = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url) as SupportedLanguage;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const normalizedPath = currentPath.replace(/\/$/, '');
const isRootRequest = normalizedPath === basePath;
const localizedPaths = Object.fromEntries(
  supportedLanguages.map((supportedLang) => [
    supportedLang,
    getLocalizedPathname(currentPath, supportedLang as SupportedLanguage),
  ])
) as Record<SupportedLanguage, string>;
const canonicalUrl = new URL(localizedPaths[lang], Astro.site);
const englishHomePath = `${basePath}/en`;
const translations =
  lang === 'es'
    ? await import('../i18n/translations/es.json')
    : await import('../i18n/translations/en.json');

function t(key: string): string {
  return (translations.default as Record<string, string>)[key] || key;
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4efe6" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />

    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}/favicon.svg`}
    />
    <link
      rel="manifest"
      href={`${import.meta.env.BASE_URL}/site.webmanifest`}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="DOF-RAG RSS"
      href={`${import.meta.env.BASE_URL}/rss.xml`}
    />

    {
      supportedLanguages.map((supportedLang) => (
        <link
          rel="alternate"
          hreflang={supportedLang}
          href={
            new URL(
              localizedPaths[supportedLang as SupportedLanguage],
              Astro.site
            )
          }
        />
      ))
    }
    {
      localizedPaths.es === `${basePath}/es` && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(`${basePath}/`, Astro.site)}
        />
      )
    }

    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light' || savedTheme === 'dark') {
        document.documentElement.classList.add(`${savedTheme}-theme`);
      }
    </script>
    <script is:inline define:vars={{ isRootRequest, englishHomePath }}>
      if (isRootRequest) {
        try {
          if (localStorage.getItem('preferredLanguage') === 'en') {
            window.location.replace(englishHomePath);
          }
        } catch {
          // The Spanish page remains usable when storage is unavailable.
        }
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner container">
        <a
          href={`${import.meta.env.BASE_URL}/${lang}`}
          class="site-brand"
          aria-label="DOF-RAG"
        >
          <img
            src={`${import.meta.env.BASE_URL}/logo-mark.svg`}
            alt=""
            width="46"
            height="46"
          />
          <span class="site-wordmark">
            DOF—RAG
            <small
              >{
                lang === 'es'
                  ? 'Archivo computacional abierto'
                  : 'Open computational archive'
              }</small
            >
          </span>
        </a>

        <nav
          class="desktop-navigation"
          aria-label={lang === 'es'
            ? 'Navegación principal'
            : 'Main navigation'}
        >
          <a href={`${import.meta.env.BASE_URL}/${lang}`}>{t('nav.home')}</a>
          <a href={`${import.meta.env.BASE_URL}/${lang}/about`}
            >{t('nav.about')}</a
          >

          <details class="language-menu">
            <summary>{lang.toUpperCase()}</summary>
            <div class="language-dropdown">
              {
                Object.entries(ui).map(([langCode, langName]) => (
                  <a
                    href={getLocalizedPathname(
                      currentPath,
                      langCode as SupportedLanguage
                    )}
                    aria-current={lang === langCode ? 'page' : undefined}
                    data-language-choice={langCode}
                    data-astro-prefetch="tap"
                  >
                    {langName}
                  </a>
                ))
              }
            </div>
          </details>

          <button
            class="theme-toggle"
            type="button"
            aria-label={t('common.change_theme')}
            aria-pressed="false"
          >
            <span class="theme-light-icon" aria-hidden="true">☀</span>
            <span class="theme-dark-icon" aria-hidden="true">◐</span>
          </button>

          <a
            class="header-github"
            href="https://github.com/CodeandoGuadalajara/dof-rag"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>

        <details class="mobile-navigation">
          <summary>{t('common.menu')}</summary>
          <nav
            aria-label={lang === 'es'
              ? 'Navegación móvil'
              : 'Mobile navigation'}
          >
            <a href={`${import.meta.env.BASE_URL}/${lang}`}>{t('nav.home')}</a>
            <a href={`${import.meta.env.BASE_URL}/${lang}/about`}
              >{t('nav.about')}</a
            >
            <a href="https://github.com/CodeandoGuadalajara/dof-rag">GitHub ↗</a
            >
            <div class="mobile-navigation-footer">
              {
                Object.entries(ui).map(([langCode, langName]) => (
                  <a
                    href={getLocalizedPathname(
                      currentPath,
                      langCode as SupportedLanguage
                    )}
                    aria-current={lang === langCode ? 'page' : undefined}
                    data-language-choice={langCode}
                    data-astro-prefetch="tap"
                  >
                    {langName}
                  </a>
                ))
              }
              <button
                class="theme-toggle"
                type="button"
                aria-label={t('common.change_theme')}
                aria-pressed="false"
              >
                <span class="theme-light-icon" aria-hidden="true">☀</span>
                <span class="theme-dark-icon" aria-hidden="true">◐</span>
              </button>
            </div>
          </nav>
        </details>
      </div>
    </header>

    {
      isRootRequest && (
        <aside class="language-suggestion" hidden data-language-suggestion>
          <div class="language-suggestion-inner container">
            <p>Your browser is set to English.</p>
            <div>
              <a
                href={englishHomePath}
                data-language-choice="en"
                data-astro-prefetch="tap"
              >
                View this site in English <span aria-hidden="true">→</span>
              </a>
              <button type="button" data-language-choice="es">
                Continuar en español
              </button>
            </div>
          </div>
        </aside>
      )
    }

    <main class="site-main container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner container">
        <div class="footer-brand">
          <img
            src={`${import.meta.env.BASE_URL}/logo-mark.svg`}
            alt=""
            width="38"
            height="38"
          />
          <div>
            <strong>DOF—RAG</strong>
            <p>{t('footer.description')}</p>
          </div>
        </div>
        <nav class="footer-navigation" aria-label={t('footer.resources')}>
          <a href={`${import.meta.env.BASE_URL}/${lang}`}>{t('nav.home')}</a>
          <a href={`${import.meta.env.BASE_URL}/${lang}/about`}
            >{t('nav.about')}</a
          >
          <a href={`${import.meta.env.BASE_URL}/rss.xml`}>RSS</a>
          <a href="mailto:contacto@dofrag.mx">contacto@dofrag.mx</a>
        </nav>
      </div>
      <div class="footer-colophon container">
        <span
          >{
            lang === 'es'
              ? 'Investigación abierta desde México.'
              : 'Open research from Mexico.'
          }</span
        >
        <span>Codeando Guadalajara</span>
      </div>
    </footer>
  </body>
</html>

<script>
  const themeButtons =
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle');

  function isLightTheme(): boolean {
    if (document.documentElement.classList.contains('light-theme')) return true;
    if (document.documentElement.classList.contains('dark-theme')) return false;
    return window.matchMedia('(prefers-color-scheme: light)').matches;
  }

  function syncThemeButtons(): void {
    const light = isLightTheme();
    themeButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(!light));
      button
        .querySelector('.theme-light-icon')
        ?.classList.toggle('is-hidden', light);
      button
        .querySelector('.theme-dark-icon')
        ?.classList.toggle('is-hidden', !light);
    });
  }

  themeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const nextTheme = isLightTheme() ? 'dark' : 'light';
      document.documentElement.classList.remove('light-theme', 'dark-theme');
      document.documentElement.classList.add(`${nextTheme}-theme`);
      localStorage.setItem('theme', nextTheme);
      syncThemeButtons();
    });
  });

  syncThemeButtons();

  const languageSuggestion = document.querySelector<HTMLElement>(
    '[data-language-suggestion]'
  );

  let savedLanguage: string | null = null;
  try {
    savedLanguage = localStorage.getItem('preferredLanguage');
  } catch {
    // Language links still work when storage is unavailable.
  }

  if (
    languageSuggestion &&
    !savedLanguage &&
    navigator.language.toLowerCase().startsWith('en')
  ) {
    languageSuggestion.hidden = false;
  }

  document
    .querySelectorAll<HTMLElement>('[data-language-choice]')
    .forEach((control) => {
      control.addEventListener('click', () => {
        const language = control.dataset.languageChoice;
        if (language !== 'es' && language !== 'en') return;

        try {
          localStorage.setItem('preferredLanguage', language);
        } catch {
          // The chosen link remains navigable when storage is unavailable.
        }

        if (language === 'es') languageSuggestion?.setAttribute('hidden', '');
      });
    });
</script>
