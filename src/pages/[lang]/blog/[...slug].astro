---
import { getCollection, render } from 'astro:content';
import {
  comparePostsByDateDesc,
  getEntryLang,
  getPostUrlPath,
} from '../../../lib/content-utils.ts';
import BlogPostLayout from '../../../layouts/BlogPostLayout.astro';
import { getLangFromUrl } from '../../../i18n/utils.ts';
import { dateFormatOptions, type SupportedLanguage } from '../../../i18n/config.ts';

// Obtener el idioma actual de la URL
const urlLang = getLangFromUrl(Astro.url) as SupportedLanguage;

// Importar traducciones
const translations = urlLang === 'es' 
  ? await import('../../../i18n/translations/es.json')
  : await import('../../../i18n/translations/en.json');

function t(key: string): string {
  return (translations.default as Record<string, string>)[key] || key;
}

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');

  const entriesByLanguage = {
    es: blogEntries
      .filter((entry) => getEntryLang(entry.id) === 'es')
      .sort(comparePostsByDateDesc),
    en: blogEntries
      .filter((entry) => getEntryLang(entry.id) === 'en')
      .sort(comparePostsByDateDesc),
  };

  const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

  function navigationLink(
    entry: (typeof blogEntries)[number],
    lang: SupportedLanguage
  ) {
    return {
      title: entry.data.title,
      href: `${basePath}/${lang}/blog/${getPostUrlPath(entry)}/`,
    };
  }

  return blogEntries.map(entry => {
    // Detectar el idioma del post basado en la ruta si está en una carpeta específica de idioma
    const postLang: SupportedLanguage = getEntryLang(entry.id);
    const languageEntries = entriesByLanguage[postLang];
    const entryIndex = languageEntries.findIndex(
      (candidate) => candidate.id === entry.id
    );
    const newerEntry = languageEntries[entryIndex - 1];
    const olderEntry = languageEntries[entryIndex + 1];

    // El slug se deriva de la fecha del frontmatter (YYYY/MM/slug),
    // no de la estructura de carpetas (los archivos están planos por idioma)
    return {
      params: {
        lang: postLang,
        slug: getPostUrlPath(entry)
      },
      props: {
        entry,
        lang: postLang,
        previousPost: olderEntry
          ? navigationLink(olderEntry, postLang)
          : undefined,
        nextPost: newerEntry
          ? navigationLink(newerEntry, postLang)
          : undefined,
      },
    };
  });
}

const { entry, lang, previousPost, nextPost } = Astro.props;
const entryLang = lang as SupportedLanguage;
const { Content } = await render(entry);

// Formatear la fecha según el idioma
function formatDate(dateObj: Date): string {
  try {
    return dateObj.toLocaleDateString(
      entryLang === 'es' ? 'es-ES' : 'en-US', 
      dateFormatOptions[entryLang]
    );
  } catch (error) {
    console.error(`Error al formatear la fecha:`, error);
    return t('common.date_not_available');
  }
}
---

<BlogPostLayout
  title={entry.data.title}
  description={entry.data.description}
  date={formatDate(entry.data.date)}
  author={entry.data.author || t('common.unknown_author')}
  image={entry.data.image}
  tags={entry.data.tags}
  lang={entryLang}
  previousPost={previousPost}
  nextPost={nextPost}
>
  <Content />
</BlogPostLayout>
